@@ -0,0 +1,14 @@
+package org.rsmod.game.entity.player
+
+import org.rsmod.game.entity.Player
+
+/**
+ * `true` for a player with no backing account row: a headless test bot (`content/other/botswarm`)
+ * spawned with a non-positive character id. Real characters always have `characterId > 0`.
+ *
+ * Every path that persists a player or reports it to Central must skip these, or a bot could
+ * overwrite (or fail foreign keys against) real account data. Autosave already uses the same rule:
+ * `PlayerAutosaveOrchestrator.persistenceSaveEligible` requires `accountId > 0 && characterId > 0`.
+ */
+public val Player.isSyntheticAccount: Boolean
+    get() = characterId <= 0
